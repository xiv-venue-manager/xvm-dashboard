// Prisma Schema for FFXIV Venue Manager
// Multi-tenant SaaS platform for managing FFXIV RP venues

generator client {
  provider = "prisma-client"
  output   = "../generated/prisma"
}

datasource db {
  provider = "postgresql"
}

// ============================================
// USER & AUTHENTICATION
// ============================================

model User {
  id            String    @id @default(cuid())
  email         String?   @unique
  emailVerified DateTime?
  name          String?
  image         String?
  discordId     String?   @unique
  displayName   String?
  settings      Json?
  isAdmin       Boolean   @default(false)
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  // Relations
  accounts                  Account[]
  sessions                  Session[]
  memberships               Membership[]
  createdEvents             Event[]                 @relation("EventCreator")
  createdEventTemplates     EventTemplate[]         @relation("EventTemplateCreator")
  assignedTasks             Task[]                  @relation("AssignedTasks")
  completedTasks            Task[]                  @relation("TaskCompleter")
  transactions              Transaction[]
  paidPayrollEntries        PayrollEntry[]          @relation("PayrollPaidBy")
  potDistributionsGenerated PotDistribution[]       @relation("PotDistributionGeneratedBy")
  feedback                  Feedback[]
  reviewedFeedback          Feedback[]              @relation("FeedbackReviewer")
  patronLogs                PatronLog[]             @relation("PatronLogger")
  patronLogsWorking         PatronLog[]             @relation("PatronLogWorking")
  patronLogsReclassified    PatronLog[]             @relation("PatronLogReclassifier")
  bannedPatronsSet          Patron[]                @relation("PatronBannedBy")
  characters                UserCharacter[]
  apiKeys                   ApiKey[]
  pendingNotifications      PendingNotification[]
  venueFollows              VenueFollow[]
  shoutTemplates            ShoutTemplate[]
  shiftAuditLogs            ShiftAuditLog[]
  notifications             Notification[]
  announcementDismissals    AnnouncementDismissal[]
  announcements             Announcement[]
  xvmApiCredential          XvmApiCredential?

  @@map("users")
}

model Notification {
  id        String   @id @default(cuid())
  userId    String
  type      String // NEW_FOLLOWER | STAFF_JOINED | TASK_ASSIGNED | TASK_COMPLETED
  title     String
  body      String
  link      String?
  read      Boolean  @default(false)
  createdAt DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, read])
  @@index([userId, createdAt(sort: Desc)])
  @@map("notifications")
}

model ShoutTemplate {
  id          String   @id @default(cuid())
  userId      String
  user        User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  label       String
  fields      Json
  templateId  String
  separatorId String
  decorId     String
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@index([userId])
  @@map("shout_templates")
}

// Bridge between a user account and their FFXIV character(s). Required so
// the plugin (which only knows characterName + world) can classify a
// patron_log entry as "staff working" vs "patron" — shift state is per
// user, so we need the character → user lookup.
model UserCharacter {
  id            String   @id @default(cuid())
  userId        String
  characterName String
  world         String
  isPrimary     Boolean  @default(false)
  createdAt     DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([characterName, world])
  @@index([userId])
  @@map("user_characters")
}

model Account {
  id                String  @id @default(cuid())
  userId            String
  type              String
  provider          String
  providerAccountId String
  refresh_token     String? @db.Text
  access_token      String? @db.Text
  expires_at        Int?
  token_type        String?
  scope             String?
  id_token          String? @db.Text
  session_state     String?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
  @@map("accounts")
}

model Session {
  id           String   @id @default(cuid())
  sessionToken String   @unique
  userId       String
  expires      DateTime
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("sessions")
}

model VerificationToken {
  identifier String
  token      String   @unique
  expires    DateTime

  @@unique([identifier, token])
  @@map("verification_tokens")
}

// ============================================
// VENUES (Multi-tenant core entity)
// ============================================

model Venue {
  id            String   @id @default(cuid())
  name          String
  slug          String   @unique
  description   String?  @db.Text
  logoUrl       String?
  bannerUrl     String?
  galleryImages String[] @default([])

  // FFXIV Location
  dataCenter String
  world      String
  district   String?
  ward       Int?
  plot       Int? // mutually exclusive with apartment
  apartment  Int? // mutually exclusive with plot

  // Settings
  timezone     String @default("UTC")
  currencyName String @default("Gil")
  settings     Json   @default("{\"taskVisibility\":\"all\",\"salesVisibility\":\"all\",\"revenueVisibility\":\"all\",\"eventVisibility\":\"all\",\"webhooks\":{\"taskCreated\":false,\"taskCompleted\":false,\"partakeEvent\":false,\"saleLogged\":false,\"dailySalesSummary\":false,\"staffJoined\":false},\"discordWebhooks\":{\"staff\":\"\",\"events\":\"\",\"revenue\":\"\"}}")

  // Venue type (owner-set category)
  venueType VenueType?

  // Partake Integration
  partakeTeamId Int?

  // ffxivvenues.com Integration
  ffxivVenueId       String?   @unique
  ffxivVenueLinkedAt DateTime?
  ffxivVenueLinkedBy String?

  // xvm-api Integration
  xvmApiVenueId       String?   @unique
  xvmApiVenueLinkedAt DateTime?
  xvmApiVenueLinkedBy String?

  // Frogge Bot Integration
  froggeVenueId     String?   @unique
  froggeToken       String?
  froggeConnectedAt DateTime?
  froggeConnectedBy String?

  // Discord Integration (deprecated - kept for migration)
  discordWebhookUrl String?
  discordServerId   String?

  // Metadata
  ownerId   String
  isActive  Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  // Relations
  memberships            Membership[]
  events                 Event[]
  eventTemplates         EventTemplate[]
  roles                  Role[]
  services               Service[]
  transactions           Transaction[]
  tasks                  Task[]
  webhooks               Webhook[]
  payrollEntries         PayrollEntry[]
  shifts                 Shift[]
  patronLogs             PatronLog[]
  patrons                Patron[]
  apiKeys                ApiKey[]
  follows                VenueFollow[]
  scheduleEntries        VenueScheduleEntry[]
  venueSchedule          VenueSchedule?
  shiftSignupEmbeds      ShiftSignupEmbed[]
  venuePotSettings       VenuePotSettings?
  potDistributions       PotDistribution[]
  venueInventorySettings VenueInventorySettings?

  @@map("venues")
}

model VenueScheduleEntry {
  id              String           @id @default(cuid())
  venueId         String
  day             Int // 0=Sun, 1=Mon, 2=Tue, 3=Wed, 4=Thu, 5=Fri, 6=Sat
  startHour       Int // 0-23 UTC / Server Time
  startMin        Int // 0-59
  endHour         Int? // null = no fixed end time
  endMin          Int?
  crossesMidnight Boolean          @default(false) // end time is next calendar day
  interval        ScheduleInterval @default(WEEKLY)
  weekOfMonth     Int? // monthly only: 1=first 2=second 3=third 4=fourth 5=last
  commencing      DateTime? // biweekly only: anchor date to determine which weeks
  label           String? // optional e.g. "DJ Night"
  createdAt       DateTime         @default(now())
  updatedAt       DateTime         @updatedAt

  venue Venue @relation(fields: [venueId], references: [id], onDelete: Cascade)

  @@index([venueId])
  @@map("venue_schedule_entries")
}

model VenueSchedule {
  id       String   @id @default(cuid())
  venueId  String   @unique
  source   String
  data     Json
  syncedAt DateTime @updatedAt

  venue Venue @relation(fields: [venueId], references: [id], onDelete: Cascade)

  @@map("venue_schedules")
}

// ============================================
// MEMBERSHIPS & ROLES
// ============================================

enum VenueType {
  BAR_TAVERN
  NIGHTCLUB
  LOUNGE
  HOST_CLUB
  CABARET
  BATHHOUSE
  CASINO
  STUDIO
  OTHER
  TEST_VENUE
}

enum ScheduleInterval {
  WEEKLY
  BIWEEKLY
  MONTHLY
}

enum MembershipRole {
  OWNER
  MANAGER
  STAFF
}

model Membership {
  id       String         @id @default(cuid())
  userId   String? // Nullable until invite is accepted
  venueId  String
  role     MembershipRole @default(STAFF)
  roleId   String? // Custom role assignment
  hireDate DateTime       @default(now())
  status   String         @default("pending") // pending, active, inactive

  // Invite system
  inviteToken     String?   @unique
  inviteExpiresAt DateTime?
  invitedBy       String? // User ID who created the invite
  invitedEmail    String? // Email for display purposes only (not used for auth)
  invitedName     String? // Name placeholder for invited staff
  nickname        String? // Venue-specific display name set by managers

  // Compensation
  hourlyRate Decimal? @db.Decimal(10, 2) // Default hourly rate for this member at this venue
  tipPooled  Boolean?

  // Temporary role system (for deputizing staff)
  temporaryRole          MembershipRole? // Elevated role while deputized
  temporaryRoleExpiresAt DateTime? // When temporary role expires
  permanentRole          MembershipRole? // Original role to revert back to

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  user            User?                      @relation(fields: [userId], references: [id], onDelete: Cascade)
  venue           Venue                      @relation(fields: [venueId], references: [id], onDelete: Cascade)
  customRole      Role?                      @relation(fields: [roleId], references: [id])
  additionalRoles MembershipRoleAssignment[]
  payrollEntries  PayrollEntry[]
  shifts          Shift[]

  @@index([venueId, userId])
  @@index([venueId, role])
  @@index([inviteToken])
  @@map("memberships")
}

model Role {
  id                  String        @id @default(cuid())
  venueId             String
  name                String
  color               String?       @default("#6366f1")
  responsibilities    String?       @db.Text
  permissions         Json          @default("{}")
  hourlyRate          Decimal?      @db.Decimal(10, 2)
  potPayoutMode       PotPayoutMode @default(STANDARD)
  contractorSharesPot Boolean       @default(false)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  venue         Venue                      @relation(fields: [venueId], references: [id], onDelete: Cascade)
  memberships   Membership[]
  additionalFor MembershipRoleAssignment[]
  shifts        Shift[]
  services      Service[] // Services this role can provide
  assignedTasks Task[]                     @relation("RoleTasks") // Tasks assigned to this role

  @@unique([venueId, name])
  @@map("roles")
}

model MembershipRoleAssignment {
  id           String @id @default(cuid())
  membershipId String
  roleId       String

  createdAt DateTime @default(now())

  membership Membership @relation(fields: [membershipId], references: [id], onDelete: Cascade)
  role       Role       @relation(fields: [roleId], references: [id], onDelete: Cascade)

  @@unique([membershipId, roleId])
  @@index([roleId])
  @@map("membership_role_assignments")
}

// ============================================
// EVENTS & CALENDAR
// ============================================

enum EventType {
  PERFORMANCE
  GAME_NIGHT
  SPECIAL
  SOCIAL
  PRIVATE
  OTHER
}

enum EventStatus {
  DRAFT
  PUBLISHED
  ACTIVE
  COMPLETED
  CANCELLED
}

model Event {
  id          String      @id @default(cuid())
  venueId     String
  title       String
  description String?     @db.Text
  location    String?     @db.Text
  eventType   EventType   @default(OTHER)
  status      EventStatus @default(DRAFT)

  // Scheduling
  startTime DateTime
  endTime   DateTime
  timezone  String   @default("UTC")

  // Recurrence (future feature)
  recurrenceRule String? // iCal RRULE format
  parentEventId  String? // For recurring event instances

  // Partake sync
  partakeEventId       Int? @unique
  partakeAttendeeCount Int?

  // Discord post tracking (Partake mirror)
  discordMessageId      String?
  discordWebhookGroup   String?
  discordContentHash    String?
  discordCancelledAt    DateTime?
  discordReminderSentAt DateTime?

  // Tracking
  attendanceCount Int?
  revenue         Decimal? @db.Decimal(10, 2)

  // Metadata
  createdById String
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  venue             Venue              @relation(fields: [venueId], references: [id], onDelete: Cascade)
  createdBy         User               @relation("EventCreator", fields: [createdById], references: [id])
  parentEvent       Event?             @relation("EventRecurrence", fields: [parentEventId], references: [id])
  childEvents       Event[]            @relation("EventRecurrence")
  transactions      Transaction[]
  patronLogs        PatronLog[]
  shiftSignupEmbeds ShiftSignupEmbed[]
  shifts            Shift[]
  potDistribution   PotDistribution?

  @@unique([parentEventId, startTime])
  @@index([venueId, startTime])
  @@index([venueId, status])
  @@index([createdById])
  @@map("events")
}

model EventTemplate {
  id          String    @id @default(cuid())
  venueId     String
  name        String // Template name (e.g., "Weekly Trivia Night")
  title       String // Event title to use when creating from template
  description String?   @db.Text
  eventType   EventType @default(OTHER)
  timezone    String    @default("UTC")

  // Store default times as "HH:MM" format (e.g., "19:00", "22:00")
  defaultStartTime String @default("19:00") // 7:00 PM
  defaultEndTime   String @default("22:00") // 10:00 PM

  // Metadata
  createdById String
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  venue     Venue @relation(fields: [venueId], references: [id], onDelete: Cascade)
  createdBy User  @relation("EventTemplateCreator", fields: [createdById], references: [id])

  @@index([venueId])
  @@map("event_templates")
}

// ============================================
// PATRON TRACKING
// ============================================

enum PatronAction {
  ENTER
  EXIT
}

model PatronLog {
  id            String   @id @default(cuid())
  venueId       String
  eventId       String? // Optional: associate with specific event
  characterName String? // FFXIV character name (from Dalamud plugin)
  world         String? // FFXIV home world (from Dalamud plugin)
  action        String   @default("ENTER") // ENTER, EXIT/LEAVE, PRESENT
  countChange   Int? // +1 for ENTER, -1 for EXIT (nullable for character-level logs)
  loggedBy      String? // User ID that logged this (staff or API key user)
  timestamp     DateTime @default(now()) // When the event actually happened
  loggedAt      DateTime @default(now()) // When the server received/recorded it

  // Was the character's user clocked into an ACTIVE shift at this venue
  // when they walked in? Snapshotted at insert time so later shift edits
  // don't rewrite history. Off-duty staff → wasWorking = false (they're
  // a patron that night).
  wasWorking    Boolean @default(false)
  workingUserId String? // The user whose character was on shift (only set when wasWorking=true)

  // Manual reclassification audit (OWNER/MANAGER override). Null = original snapshot, untouched.
  reclassifiedAt   DateTime?
  reclassifiedById String?
  reclassifyReason String?

  venue          Venue  @relation(fields: [venueId], references: [id], onDelete: Cascade)
  event          Event? @relation(fields: [eventId], references: [id], onDelete: Cascade)
  staff          User?  @relation("PatronLogger", fields: [loggedBy], references: [id])
  workingUser    User?  @relation("PatronLogWorking", fields: [workingUserId], references: [id], onDelete: SetNull)
  reclassifiedBy User?  @relation("PatronLogReclassifier", fields: [reclassifiedById], references: [id], onDelete: SetNull)

  @@index([venueId, timestamp])
  @@index([eventId, timestamp])
  @@index([venueId, characterName])
  @@index([venueId, wasWorking, timestamp])
  @@map("patron_logs")
}

model Patron {
  id            String    @id @default(cuid())
  venueId       String
  characterName String
  world         String
  isBanned      Boolean   @default(false)
  banReason     String?
  bannedAt      DateTime?
  bannedById    String?
  createdAt     DateTime  @default(now())

  venue    Venue @relation(fields: [venueId], references: [id], onDelete: Cascade)
  bannedBy User? @relation("PatronBannedBy", fields: [bannedById], references: [id], onDelete: SetNull)

  @@unique([venueId, characterName, world])
  @@index([venueId, isBanned])
  @@map("patrons")
}


// ============================================
// SERVICES & TRANSACTIONS
// ============================================

model Service {
  id          String  @id @default(cuid())
  venueId     String
  name        String
  description String? @db.Text
  price       Decimal @db.Decimal(10, 2)
  category    String?
  isActive    Boolean @default(true)

  // Set once this row has been backfilled into xvm-api's Service module —
  // lets the one-time migration script (scripts/migrate-services-to-xvm-api.ts)
  // skip rows it already created on a re-run.
  xvmApiServiceId Int?

  // Bar inventory mapping — a drink is an existing Service with these
  // populated. linkedItemId is the real FFXIV item ID (source of truth);
  // name/icon are a display cache either search path can refresh.
  // stockCount null = not inventory-tracked, even when the venue's
  // VenueInventorySettings.enabled is true (opt-in per venue AND per service).
  linkedItemId   Int?
  linkedItemName String?
  linkedItemIcon Int?
  stockCount     Int?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  venue        Venue         @relation(fields: [venueId], references: [id], onDelete: Cascade)
  transactions Transaction[]
  roles        Role[] // Roles that can provide this service

  @@map("services")
}

enum TransactionType {
  SALE
  TIP
  COVER_CHARGE
  OTHER

  @@map("transaction_type")
}

model Transaction {
  id        String  @id @default(cuid())
  venueId   String
  eventId   String?
  serviceId String?
  staffId   String?

  // Transaction details
  type         TransactionType @default(SALE)
  amount       Decimal         @db.Decimal(10, 2)
  customerName String?
  notes        String?         @db.Text

  createdAt DateTime @default(now())

  venue   Venue    @relation(fields: [venueId], references: [id], onDelete: Cascade)
  event   Event?   @relation(fields: [eventId], references: [id])
  service Service? @relation(fields: [serviceId], references: [id])
  staff   User?    @relation(fields: [staffId], references: [id])

  @@index([venueId, createdAt])
  @@index([venueId, serviceId])
  @@index([staffId])
  @@map("transactions")
}

// ============================================
// TASKS & ASSIGNMENTS
// ============================================

enum TaskStatus {
  PENDING
  IN_PROGRESS
  COMPLETED
  CANCELLED
}

enum TaskPriority {
  LOW
  MEDIUM
  HIGH
  URGENT
}

model Task {
  id             String  @id @default(cuid())
  venueId        String
  assignedTo     String?
  assignedRoleId String? // Role assigned to complete this task (alternative to assignedTo)

  // Task details
  title       String
  description String?      @db.Text
  status      TaskStatus   @default(PENDING)
  priority    TaskPriority @default(MEDIUM)
  category    String? // setup, cleanup, promotional, etc.

  // Scheduling
  dueDate     DateTime?
  completedAt DateTime?
  completedBy String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  venue        Venue @relation(fields: [venueId], references: [id], onDelete: Cascade)
  assignee     User? @relation("AssignedTasks", fields: [assignedTo], references: [id])
  assignedRole Role? @relation("RoleTasks", fields: [assignedRoleId], references: [id])
  completer    User? @relation("TaskCompleter", fields: [completedBy], references: [id])

  @@index([venueId, status, priority])
  @@index([assignedTo])
  @@index([assignedRoleId])
  @@map("tasks")
}

// ============================================
// PAYROLL & COMPENSATION
// ============================================

enum PaymentType {
  FIXED_SALARY // Set pay per period
  HOURLY // Pay per hour worked
  POT_SHARE
  CONTRACTOR_PAYOUT
}

enum PotPayoutMode {
  STANDARD
  POT
  CONTRACTOR
}

model PayrollEntry {
  id           String  @id @default(cuid())
  venueId      String
  membershipId String? // Staff member being paid (null for manual entries)

  // Manual entry support (for temp DJs, contractors, etc.)
  isManualEntry   Boolean @default(false)
  manualEntryName String? // Name of person for manual entries

  // Payment configuration
  paymentType PaymentType
  baseRate    Decimal     @db.Decimal(10, 2) // Fixed salary or hourly rate
  hoursWorked Decimal?    @db.Decimal(6, 2) // For hourly payments
  bonusAmount Decimal?    @db.Decimal(10, 2) // Optional bonus
  totalAmount Decimal     @db.Decimal(10, 2) // Calculated total

  // Payment period
  periodStart DateTime
  periodEnd   DateTime

  // Payment status
  isPaid Boolean   @default(false)
  paidAt DateTime?
  paidBy String? // User ID who marked as paid

  // Additional details
  notes String? @db.Text

  potDistributionId String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  venue           Venue            @relation(fields: [venueId], references: [id], onDelete: Cascade)
  membership      Membership?      @relation(fields: [membershipId], references: [id], onDelete: Cascade)
  paidByUser      User?            @relation("PayrollPaidBy", fields: [paidBy], references: [id])
  shifts          Shift[] // Shifts covered by this payroll entry
  potDistribution PotDistribution? @relation(fields: [potDistributionId], references: [id], onDelete: SetNull)

  @@index([venueId, periodEnd])
  @@index([membershipId, isPaid])
  @@index([venueId, isPaid])
  @@index([venueId, isManualEntry])
  @@map("payroll_entries")
}

model PotDistribution {
  id              String   @id @default(cuid())
  venueId         String
  eventId         String
  regularSales    Decimal  @db.Decimal(10, 2)
  contractorSales Decimal  @db.Decimal(10, 2)
  pooledTips      Decimal  @db.Decimal(10, 2)
  taxPercent      Decimal  @db.Decimal(5, 2)
  potTotal        Decimal  @db.Decimal(10, 2)
  recipientCount  Int
  perPersonShare  Decimal  @db.Decimal(10, 2)
  generatedById   String
  generatedAt     DateTime @default(now())

  venue       Venue          @relation(fields: [venueId], references: [id], onDelete: Cascade)
  event       Event          @relation(fields: [eventId], references: [id], onDelete: Cascade)
  generatedBy User           @relation("PotDistributionGeneratedBy", fields: [generatedById], references: [id])
  entries     PayrollEntry[]

  @@unique([eventId])
  @@index([venueId])
  @@map("pot_distributions")
}

model VenuePotSettings {
  id                String  @id @default(cuid())
  venueId           String  @unique
  enabled           Boolean @default(false)
  taxPercent        Decimal @default(0) @db.Decimal(5, 2)
  includeSalesInPot Boolean @default(false)
  defaultTipPooled  Boolean @default(false)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  venue Venue @relation(fields: [venueId], references: [id], onDelete: Cascade)

  @@map("venue_pot_settings")
}

model VenueInventorySettings {
  id        String   @id @default(cuid())
  venueId   String   @unique
  enabled   Boolean  @default(false)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  venue Venue @relation(fields: [venueId], references: [id], onDelete: Cascade)

  @@map("venue_inventory_settings")
}

// ============================================
// WEBHOOKS & INTEGRATIONS
// ============================================

enum WebhookEvent {
  TASK_COMPLETED
  EVENT_CREATED
  EVENT_REMINDER
  SALES_DAILY_SUMMARY
  STAFF_JOINED
}

model Webhook {
  id       String         @id @default(cuid())
  venueId  String
  name     String
  url      String
  events   WebhookEvent[]
  isActive Boolean        @default(true)

  // Template customization
  template Json?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  venue Venue @relation(fields: [venueId], references: [id], onDelete: Cascade)

  @@map("webhooks")
}

// ============================================
// USER FEEDBACK & SUPPORT
// ============================================

enum FeedbackCategory {
  BUG_REPORT
  FEATURE_REQUEST
  IMPROVEMENT
  GENERAL
}

enum FeedbackStatus {
  NEW
  UNDER_REVIEW
  PLANNED
  IN_PROGRESS
  COMPLETED
  WONT_FIX
}

model Feedback {
  id          String           @id @default(cuid())
  userId      String
  category    FeedbackCategory
  status      FeedbackStatus   @default(NEW)
  subject     String
  description String           @db.Text

  // Optional context
  url        String? // Page where feedback was submitted
  userAgent  String? // Browser/device info
  screenshot String? // Optional screenshot URL

  // Admin notes
  adminNotes String?   @db.Text
  reviewedBy String?
  reviewedAt DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  user     User  @relation(fields: [userId], references: [id], onDelete: Cascade)
  reviewer User? @relation("FeedbackReviewer", fields: [reviewedBy], references: [id])

  @@index([userId])
  @@index([status, createdAt])
  @@index([category])
  @@map("feedback")
}

// ============================================
// PLUGIN / EXTERNAL API KEYS
// ============================================

model ApiKey {
  id         String    @id
  keyHash    String?   @unique
  keyPreview String?
  name       String
  userId     String
  venueId    String?
  lastUsedAt DateTime?
  createdAt  DateTime  @default(now())
  revokedAt  DateTime?

  user  User   @relation(fields: [userId], references: [id], onDelete: Cascade)
  venue Venue? @relation(fields: [venueId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([keyHash])
  @@map("api_keys")
}

model XvmApiCredential {
  id           String   @id @default(cuid())
  userId       String   @unique
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  token        String
  credentialId Int
  personId     Int?
  expiresAt    DateTime
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  @@map("xvm_api_credentials")
}

// ============================================
// SHIFTS & TIME TRACKING
// ============================================

enum ShiftStatus {
  OPEN
  CLAIMED
  SCHEDULED
  ACTIVE
  COMPLETED
  MISSED
  CANCELLED
}

model Shift {
  id             String  @id @default(cuid())
  venueId        String
  membershipId   String?
  roleId         String?
  eventId        String?
  payrollEntryId String? // Links to the payroll entry that paid for this shift

  // Schedule (set by manager when creating the shift)
  scheduledStart DateTime
  scheduledEnd   DateTime

  // Actuals (set by staff via clock-in / clock-out)
  actualStart DateTime?
  actualEnd   DateTime?
  hoursWorked Decimal?  @db.Decimal(6, 2) // Stored at clock-out for immediate display

  status ShiftStatus @default(SCHEDULED)
  notes  String?     @db.Text

  // Recurrence: null recurrenceRule = one-off shift. Set only on the parent;
  // children reference it via parentShiftId (same pattern as Event/parentEventId).
  recurrenceRule String?
  parentShiftId  String?

  // Set only on parent rows, only when quantity > 1 was combined with repeating at
  // creation time. Ties together N independent recurring series (each with its own
  // parentShiftId chain) created from a single "N open slots, repeating" submission,
  // so they can optionally be cancelled together via cancel-group. Null for everything
  // else — including quantity=1 recurring shifts and non-recurring quantity>1 shifts.
  slotGroupId String?

  // Set by eorzea-bot's reminder poll job when it sends a shift-starting-soon DM.
  // Owned by this model (it's a real Shift column) even though the bot, not this
  // app, writes to it.
  remindedAt DateTime? @map("reminded_at") @db.Timestamptz(6)

  shiftSignupEmbedId String?
  shiftSignupEmbed   ShiftSignupEmbed? @relation(fields: [shiftSignupEmbedId], references: [id], onDelete: SetNull)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  venue        Venue           @relation(fields: [venueId], references: [id], onDelete: Cascade)
  membership   Membership?     @relation(fields: [membershipId], references: [id], onDelete: Cascade)
  role         Role?           @relation(fields: [roleId], references: [id], onDelete: SetNull)
  event        Event?          @relation(fields: [eventId], references: [id], onDelete: SetNull)
  payrollEntry PayrollEntry?   @relation(fields: [payrollEntryId], references: [id], onDelete: SetNull)
  auditLogs    ShiftAuditLog[]

  parentShift Shift?  @relation("ShiftRecurrence", fields: [parentShiftId], references: [id])
  childShifts Shift[] @relation("ShiftRecurrence")

  @@index([venueId, scheduledStart])
  @@index([membershipId, status])
  @@index([venueId, status])
  @@index([payrollEntryId])
  @@index([roleId])
  @@index([eventId, status])
  @@index([shiftSignupEmbedId])
  @@map("shifts")
}

// Audit trail for clock-in/out and claim/approve/reject actions on a shift.
// actorUserId is null for system-initiated changes (e.g. auto-miss sweeps).
model ShiftAuditLog {
  id          String   @id @default(cuid())
  shiftId     String
  action      String // CLOCK_IN, CLOCK_OUT, CLAIM, APPROVE, REJECT
  actorUserId String?
  source      String // web, mobile_self, mobile_operator, plugin
  createdAt   DateTime @default(now())

  shift Shift @relation(fields: [shiftId], references: [id], onDelete: Cascade)
  actor User? @relation(fields: [actorUserId], references: [id], onDelete: SetNull)

  @@index([shiftId])
  @@index([actorUserId])
  @@map("shift_audit_logs")
}

model ShiftSignupEmbed {
  id               String    @id @default(cuid())
  venueId          String
  eventId          String
  templateName     String
  discordMessageId String    @unique
  channelId        String
  scheduledStart   DateTime
  scheduledEnd     DateTime
  slots            Int
  waitlist         Json      @default("[]")
  postedAt         DateTime  @default(now())
  cancelledAt      DateTime?

  venue  Venue   @relation(fields: [venueId], references: [id], onDelete: Cascade)
  event  Event   @relation(fields: [eventId], references: [id], onDelete: Cascade)
  shifts Shift[]

  @@unique([eventId, templateName])
  @@index([venueId])
  @@index([eventId])
  @@map("shift_signup_embeds")
}

// ============================================
// PUSH NOTIFICATIONS (Phase 4)
// ============================================

enum NotificationType {
  SHIFT_REMINDER
  SHIFT_CLAIM_APPROVED
  SHIFT_CLAIM_REJECTED
  SHIFT_CLAIM_SUBMITTED
  VENUE_OPENED_NOW
  EVENT_REMINDER_30M
}

model PendingNotification {
  id           String           @id @default(cuid())
  userId       String
  type         NotificationType
  title        String
  body         String
  data         Json?
  scheduledFor DateTime
  sentAt       DateTime?
  receiptId    String?
  createdAt    DateTime         @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([scheduledFor, sentAt])
  @@index([userId])
  @@map("pending_notifications")
}

model VenueFollow {
  id                 String   @id @default(cuid())
  userId             String
  venueId            String
  visibleToOperators Boolean  @default(false)
  createdAt          DateTime @default(now())

  user  User  @relation(fields: [userId], references: [id], onDelete: Cascade)
  venue Venue @relation(fields: [venueId], references: [id], onDelete: Cascade)

  @@unique([userId, venueId])
  @@index([venueId])
  @@map("venue_follows")
}

// ============================================
// ANNOUNCEMENTS
// ============================================

model Announcement {
  id        String    @id @default(cuid())
  title     String
  message   String
  link      String?
  linkLabel String?
  expiresAt DateTime?
  createdAt DateTime  @default(now())
  createdBy String

  author     User                    @relation(fields: [createdBy], references: [id])
  dismissals AnnouncementDismissal[]

  @@map("announcements")
}

model AnnouncementDismissal {
  userId         String
  announcementId String
  dismissedAt    DateTime @default(now())

  user         User         @relation(fields: [userId], references: [id], onDelete: Cascade)
  announcement Announcement @relation(fields: [announcementId], references: [id], onDelete: Cascade)

  @@id([userId, announcementId])
  @@map("announcement_dismissals")
}

// ============================================
// SHADOW MODELS — owned by apps/eorzea-bot, not this app
// ============================================
// apps/eorzea-bot has its own Prisma schema and writes to these tables directly
// in the same shared Postgres database. They're declared here, unused by any
// query in this app, purely so `prisma db push` sees them as already matching
// and leaves them alone. Source of truth for shape/migrations is
// apps/eorzea-bot/prisma/schema.prisma — mirror changes there here too.

model DiscordGilReactionReward {
  id        String   @id
  discordId String
  messageId String
  createdAt DateTime @default(now()) @db.Timestamp(6)

  @@unique([discordId, messageId])
  @@map("discord_gil_reaction_rewards")
}

model DiscordGuildConfig {
  guildId          String  @id
  welcomeChannelId String?
  logChannelId     String?
  autoRoleId       String?
  rulesChannelId   String?

  @@map("discord_guild_config")
}

model DiscordMember {
  id               String    @id @default(dbgenerated("(gen_random_uuid())::text"))
  discordId        String    @unique
  guildId          String
  xp               Int       @default(0)
  level            Int       @default(1)
  gil              Int       @default(0)
  warns            Int       @default(0)
  createdAt        DateTime  @default(now()) @db.Timestamptz(6)
  updatedAt        DateTime  @default(now()) @db.Timestamptz(6)
  gc               String?
  xpBoostExpiresAt DateTime? @db.Timestamp(6)
  cooldownSkips    Int       @default(0)

  @@map("discord_members")
}

model DiscordOpenVenue {
  venueId    String   @id
  venueName  String
  dataCenter String
  openedAt   DateTime @default(now()) @db.Timestamp(6)

  @@map("discord_open_venues")
}

model DiscordTrackedMessage {
  key       String   @id
  channelId String
  messageId String
  updatedAt DateTime @default(now()) @db.Timestamp(6)

  @@map("discord_tracked_messages")
}

model DiscordWarnLog {
  id          String   @id @default(dbgenerated("(gen_random_uuid())::text"))
  guildId     String
  targetId    String
  moderatorId String
  reason      String
  createdAt   DateTime @default(now()) @db.Timestamptz(6)

  @@map("discord_warn_logs")
}
