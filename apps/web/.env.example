
# MinIO (local object storage for venue gallery images)
MINIO_ENDPOINT=http://minio:9000
MINIO_PUBLIC_URL=http://your-server-ip:9000
MINIO_ROOT_USER=xivvenues
MINIO_ROOT_PASSWORD=
MINIO_BUCKET=xiv-venues

# Resend (transactional email)
RESEND_API_KEY=
RESEND_FROM="XIV Venue Manager <noreply@xivvenuemanager.com>"

# Hermes LiteLLM proxy (Shout Crafter Discord-paste LLM fallback)
HERMES_LITELLM_URL=http://192.168.1.253:4000
HERMES_LITELLM_API_KEY=

# xvm-api (Frogge's backend) — dashboard service credential + base URL
XVM_API_BASE_URL=http://localhost:8000
XVM_API_DASHBOARD_SERVICE_TOKEN=

# XIV Auth (proving which characters a person owns). Register an OAuth client in the XIV Auth
# developer portal with redirect URIs for each site, scope character:all.
XIVAUTH_CLIENT_ID=
XIVAUTH_CLIENT_SECRET=
